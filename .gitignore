# next.js
.next/
out/
build/
next-env.d.ts

# env — never commit. Explicit rather than `.env*`, which `vercel link` likes
# to append: that would also ignore .env.example, the one env file that is
# supposed to be committed because it documents the variable NAMES.
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# claude code harness artifacts
.claude/.cc-writes/
**/.claude/.cc-writes/

# os
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.bun/

# supabase CLI scratch
supabase/.temp/

# reference images are tracked on purpose — design direction is project history

