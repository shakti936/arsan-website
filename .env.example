# GoHighLevel — server-side only. Values live in .env.local (gitignored), never here.
GHL_API_KEY=
GHL_LOCATION_ID=

# Supabase (P2+, per docs/sop/07-integrations.md — anon key server-side only, ADR-013)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Sanity CMS. The site builds and runs without these — content falls back to
# src/content/** until the migration lands (docs/sop/01-decision-log.md D-090).
# Create the project with `bunx sanity login` then `bunx sanity init --env`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-side only. Needed for draft previews, not for published reads.
SANITY_API_READ_TOKEN=

# Page-copy translation ("Translate to Spanish" in the Studio). Both are
# server-side only and both are optional: without them the action reports that
# translation is not configured and changes nothing. Everything else about the
# CMS — editing copy, click-to-edit preview, publishing — works without them.
# The write token needs Editor scope; the read token above is not sufficient.
ANTHROPIC_API_KEY=
SANITY_API_WRITE_TOKEN=
